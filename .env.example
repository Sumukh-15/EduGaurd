# EduGuard Environment Configuration Example
# Copy this file to .env and adjust variables for your local setup.

# Application Settings
ENVIRONMENT=development
PROJECT_NAME="EduGuard API"
API_V1_PREFIX=/api
DEBUG=true

# Security & JWT
# Generate a secure 32+ character random secret for production:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev_secret_key_change_in_production_f7a8c9b2e1d045a6
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (PostgreSQL 18 on dedicated port 5433)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql://eduguard:eduguard_secret@localhost:5433/eduguard_db

# CORS Configuration (JSON array of allowed origins)
ALLOWED_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Machine Learning Artifact Paths (Relative to project root or absolute)
MODEL_PATH=ml/artifacts/model_v1.joblib
METADATA_PATH=ml/artifacts/model_metadata.json
